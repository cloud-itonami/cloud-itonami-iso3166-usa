#:culture{:id "usa.dish.hamburger", :name "Hamburger", :country "USA", :kind :dish, :summary "Considered a national dish of the United States; its invention remains disputed, with multiple Americans -- including Louis Lassen, Charlie Nagreen, and Fletcher Davis -- claiming credit for creating the sandwich in the late 1800s and early 1900s.", :url "https://en.wikipedia.org/wiki/Hamburger", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "usa.dish.hot-dog", :name "Hot dog", :country "USA", :kind :dish, :summary "Strongly associated with American culture after German sausages were imported to the United States; multiple figures claim credit for putting sausage in a bun, including Harry M. Stevens (1901), though it is not definitively known who started the practice.", :url "https://en.wikipedia.org/wiki/Hot_dog", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "usa.dish.apple-pie", :name "Apple pie", :country "USA", :kind :dish, :summary "Although apple pie originated in England and has been eaten throughout Europe for centuries, it became deeply embedded in American identity through the phrase \"as American as apple pie\" and evolved into a symbol of American prosperity and national pride during the 19th and 20th centuries.", :url "https://en.wikipedia.org/wiki/Apple_pie", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "usa.beverage.bourbon-whiskey", :name "Bourbon whiskey", :country "USA", :kind :beverage, :summary "Barrel-aged American whiskey made primarily from corn; in 1964 the U.S. Congress adopted a concurrent resolution declaring bourbon \"a distinctive product of the United States\" and sought to prohibit importation of whiskey labeled as bourbon from other countries.", :url "https://en.wikipedia.org/wiki/Bourbon_whiskey", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "usa.product.jeans", :name "Jeans", :country "USA", :kind :product, :summary "Trousers made from denim, originally designed as workwear for miners and laborers in the United States, with copper rivets added by Jacob W. Davis and patented by Davis and Levi Strauss in 1873.", :url "https://en.wikipedia.org/wiki/Jeans", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "usa.festival.thanksgiving", :name "Thanksgiving", :country "USA", :kind :festival, :summary "Federal holiday in the United States celebrated on the fourth Thursday of November, with origins in 17th-century New England and modern customs including feasting, parades, football games, and charitable activities.", :url "https://en.wikipedia.org/wiki/Thanksgiving_(United_States)", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "usa.heritage.statue-of-liberty", :name "Statue of Liberty", :country "USA", :kind :heritage, :summary "Colossal neoclassical sculpture on Liberty Island in New York Harbor, designed by French sculptor Frédéric Auguste Bartholdi and dedicated in 1886; designated a UNESCO World Heritage Site in 1984 as a masterpiece of human creative genius and cultural exchange between nations.", :url "https://en.wikipedia.org/wiki/Statue_of_Liberty", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "usa.heritage.independence-hall", :name "Independence Hall", :country "USA", :kind :heritage, :summary "Historic Philadelphia building where the Declaration of Independence and U.S. Constitution were debated and adopted; designated a UNESCO World Heritage Site in 1979 for its outstanding universal significance to global democratic ideals.", :url "https://en.wikipedia.org/wiki/Independence_Hall", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
]
